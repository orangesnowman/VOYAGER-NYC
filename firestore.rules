rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /users/{uid} {
      allow create, read, update: if owner(uid) || admin();
      allow delete: if admin();
      match /progress/{document=**} { allow read, write: if owner(uid) || admin(); }
    }
    match /admin/{document=**} { allow read, write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
